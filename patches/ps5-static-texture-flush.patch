+/* Only ordinary linear sampler images participate. Depth/display and
+ * image-store backings retain conservative flushing. Raw/persistent pointers
+ * cannot be tracked after they escape, so they never use clean-bit reuse. */
+static bool
+ps5_static_texture_flush_cacheable(const struct ps5_resource *resource)
+{
+   return resource && resource->base.target == PIPE_TEXTURE_2D &&
+      (resource->base.bind & PIPE_BIND_SAMPLER_VIEW) &&
+      !(resource->base.bind & (PIPE_BIND_DEPTH_STENCIL |
+                              PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SHADER_IMAGE)) &&
+      !resource->depth_staging_size &&
+      !resource->render_pool_owner && !resource->cpu_pointer_escaped &&
+      !resource->cpu_write_maps;
+}
 
