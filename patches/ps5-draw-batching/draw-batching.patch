+/* Cache only exact draw ranges of tracked static buffers. The write marker
+ * invalidates every entry; escaped, mapped, mutable and GPU-write roles bypass. */
+static bool
+ps5_index_bounds(struct ps5_resource *resource, const void *indices,
+                 size_t offset, unsigned width, unsigned count, int bias,
+                 struct ps5_index_bounds_cache *result)
+{
+   const bool cacheable = ps5_static_buffer_flush_cacheable(resource);
+   unsigned slot = ((offset >> 2) ^ count ^ width ^ (unsigned)bias) & 3u;
+   struct ps5_index_bounds_cache *cached = &resource->index_bounds[slot];
+   if (cacheable && cached->valid && cached->offset == offset &&
+       cached->width == width && cached->count == count && cached->bias == bias) {
+      *result = *cached;
+      return true;
+   }
+   struct ps5_index_bounds_cache bounds = {.offset = offset, .width = width,
+      .count = count, .bias = bias, .min_index = UINT32_MAX,
+      .min_effective = UINT32_MAX};
+   for (unsigned i = 0; i < count; ++i) {
+      unsigned index = ps5_index_value(indices, width, i);
+      if (bias < 0 && index < (uint64_t)-(int64_t)bias)
+         return false;
+      uint32_t effective = index + (uint32_t)bias;
+      bounds.min_index = MIN2(bounds.min_index, index);
+      bounds.max_index = MAX2(bounds.max_index, index);
+      bounds.min_effective = MIN2(bounds.min_effective, effective);
+      bounds.max_effective = MAX2(bounds.max_effective, effective);
+   }
+   if (bounds.max_effective == UINT32_MAX)
+      return false;
+   bounds.valid = true;
+   if (cacheable)
+      *cached = bounds;
+   *result = bounds;
+   return true;
