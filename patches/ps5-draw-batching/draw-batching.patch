+            if (intr->intrinsic == nir_intrinsic_load_input ||
+                intr->intrinsic == nir_intrinsic_load_input_vertex ||
+                intr->intrinsic == nir_intrinsic_load_per_vertex_input)
+               return true;
+         }
+      }
+   }
+   return false;
