+static void
+ps5_flush_gpu_data_group(const void *address, size_t bytes, enum ps5_flush_group group)
+{
+   const int64_t started = PS5_CPU_PROFILE_CLOCK();
+   ps5_cache_flush_range(address, bytes);
+   const uint64_t elapsed = PS5_CPU_PROFILE_CLOCK() - started;
+   PS5_CPU_PROFILE_ADD(flush_ns, elapsed);
+   PS5_CPU_PROFILE_ADD(group_ns[group], elapsed);
+   PS5_CPU_PROFILE_ADD(group_bytes[group], bytes);
+   PS5_CPU_PROFILE_ADD(group_calls[group], 1);
+   PS5_CPU_PROFILE_ADD(flush_bytes, bytes);
+   PS5_CPU_PROFILE_ADD(flush_calls, 1);
+}
+
+/* Per-draw CPU writes can share one visibility boundary. This accumulator
+ * never survives a draw and never refers to another descriptor-cache bank. */
+struct ps5_descriptor_flush_range {
+   uint8_t *data;
+   size_t first, end;
+   enum ps5_flush_group group;
+};
+
+static void
+ps5_descriptor_flush_finish(struct ps5_descriptor_flush_range *range)
+{
+   if (range->data && range->end > range->first)
+      ps5_flush_gpu_data_group(range->data + range->first,
+                              range->end - range->first, range->group);
+   memset(range, 0, sizeof(*range));
+}
+
+static void
+ps5_descriptor_flush_record(struct ps5_descriptor_flush_range *range,
+                            uint8_t *data, size_t first, size_t end,
+                            enum ps5_flush_group group)
+{
+   if (end <= first)
+      return;
+   if (!range) {
+      ps5_flush_gpu_data_group(data + first, end - first, group);
+      return;
+   }
+   if (range->data && range->data != data)
+      ps5_descriptor_flush_finish(range);
+   if (!range->data) {
+      range->data = data;
+      range->first = first;
+      range->group = group;
+   } else {
+      range->first = MIN2(range->first, first);
+   }
+   range->end = MAX2(range->end, end);
+}
