diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index d121eb0..94531d3 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1,3 +1,9 @@
+# Detailed PS5 timing is opt-in; the engine keeps its own sparse frame timings.
+OPTION(PS5_OSG_DETAILED_PROFILE "Enable detailed PS5 OSG leaf and traversal timings" OFF)
+IF(PS5_OSG_DETAILED_PROFILE)
+    ADD_DEFINITIONS(-DPS5_OSG_DETAILED_PROFILE=1)
+ENDIF()
+
 IF(ANDROID)
     SET(MODULE_USER_STATIC_OR_DYNAMIC ${OPENSCENEGRAPH_USER_DEFINED_DYNAMIC_OR_STATIC})
 ENDIF(ANDROID)
@@ -30,6 +36,9 @@ FOREACH( mylibfolder
         osgPlugins
     )
 
+    if(PS5 AND mylibfolder MATCHES "^(osgManipulator|osgUI|osgVolume|osgTerrain|osgWidget|osgPresentation)$")
+        continue()
+    endif()
     ADD_SUBDIRECTORY(${mylibfolder})
 
 ENDFOREACH()
