+#if defined(__PROSPERO__) && defined(PS5_OSG_DETAILED_PROFILE) && PS5_OSG_DETAILED_PROFILE
+    const osg::FrameStamp* ps5Stamp = state.getFrameStamp();
+    const unsigned ps5Frame = ps5Stamp ? ps5Stamp->getFrameNumber() : 0;
+    const bool ps5Sample = ps5Frame <= 3 || ps5Frame % 60 == 0;
+    osg::Timer* ps5Timer = osg::Timer::instance();
+    const osg::Timer_t ps5LeafStart = ps5Sample ? ps5Timer->tick() : 0;
+#endif
     if (previous)
     {
 
@@ -60,7 +84,17 @@ void RenderLeaf::render(osg::RenderInfo& renderInfo,RenderLeaf* previous)
         if (state.getUseModelViewAndProjectionUniforms()) state.applyModelViewAndProjectionUniformsIfRequired();
 
