+static double ps5LeafStateMs, ps5LeafDrawMs;
+static unsigned ps5LeafCount;
+extern "C" void ps5_osg_leaf_reset(void)
+{
+    ps5LeafStateMs = ps5LeafDrawMs = 0.0;
+    ps5LeafCount = 0;
+}
