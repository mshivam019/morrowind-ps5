+#if defined(__PROSPERO__) && defined(PS5_OSG_DETAILED_PROFILE) && PS5_OSG_DETAILED_PROFILE
+        const osg::Timer_t ps5DrawStart = ps5Sample ? ps5Timer->tick() : 0;
+#endif
         _drawable->draw(renderInfo);
+#if defined(__PROSPERO__) && defined(PS5_OSG_DETAILED_PROFILE) && PS5_OSG_DETAILED_PROFILE
+        if (ps5Sample) {
+            ps5LeafStateMs += ps5Timer->delta_m(ps5LeafStart, ps5DrawStart);
+            ps5LeafDrawMs += ps5Timer->delta_m(ps5DrawStart, ps5Timer->tick());
+            ++ps5LeafCount;
+        }
+#endif
     }
     else
     {
@@ -78,7 +112,17 @@ void RenderLeaf::render(osg::RenderInfo& renderInfo,RenderLeaf* previous)
         if (state.getUseModelViewAndProjectionUniforms()) state.applyModelViewAndProjectionUniformsIfRequired();
 
