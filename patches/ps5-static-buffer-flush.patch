+/* Static VBO/EBO storage has a tracked CPU-write epoch. Whole-backing flushes
+ * are necessary before clearing dirty: later draws may select other ranges. */
+static bool
+ps5_static_buffer_flush_cacheable(const struct ps5_resource *resource)
+{
+   return resource && resource->base.target == PIPE_BUFFER &&
+      (resource->base.bind & (PIPE_BIND_VERTEX_BUFFER | PIPE_BIND_INDEX_BUFFER)) &&
+      !(resource->base.bind & (PIPE_BIND_SHADER_BUFFER | PIPE_BIND_STREAM_OUTPUT |
+                              PIPE_BIND_SHADER_IMAGE | PIPE_BIND_SAMPLER_VIEW)) &&
+      (resource->base.usage == PIPE_USAGE_DEFAULT ||
+       resource->base.usage == PIPE_USAGE_IMMUTABLE) &&
+      !(resource->base.flags & PS5_RESOURCE_FLAG_UNINITIALIZED) &&
+      resource->exclusive_buffer_storage && !resource->cpu_pointer_escaped &&
+      !resource->cpu_write_maps;
+}
+
+static void
+ps5_flush_vertex_index_backing(struct ps5_batch_flush_cache *batch,
+                               struct ps5_resource *resource,
+                               const void *data, size_t bytes,
+                               enum ps5_flush_group group)
+{
+   if (!ps5_static_buffer_flush_cacheable(resource)) {
+      ps5_flush_batch_backing(batch, 0, data, bytes, group);
+      return;
+   }
+   if (resource->cpu_dirty) {
+      ps5_flush_batch_backing(batch, 0, resource->data, resource->size, group);
+      resource->cpu_dirty = false;
+   }
+}
